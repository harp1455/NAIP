{
  "name": "naip",
  "private": true,
  "version": "0.1.0",
  "description": "NAIP - NovelAI bulk image generation client for Android (based on NAIS3)",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
