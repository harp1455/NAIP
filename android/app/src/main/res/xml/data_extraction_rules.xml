<?xml version="1.0" encoding="utf-8"?>
<!--
    암호화한 토큰(NaipSecurePlugin, naip_secure.xml)은 기기 밖으로 보내지 않는다.
    그 값을 잠근 Android Keystore 키는 기기를 떠나지 않아, 새 기기에서는 풀 수 없는 암호문만 남는다.
    targetSdk 31+에서 allowBackup="false"는 클라우드 백업만 막고 기기 간 전송(D2D)은 막지 않는다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="naip_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="naip_secure.xml" />
    </device-transfer>
</data-extraction-rules>
